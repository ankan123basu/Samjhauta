# ─── Samjhauta — Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your keys.
# Both providers are FREE TIER — no credit card required for the default models.

# Agent A: Groq (Llama 3.3 70B + Whisper STT)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Agent B: Google Gemini (Gemini 2.5 Flash)
# Get free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Backend server config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Negotiation engine tuning
MAX_TURNS=20
DEADLOCK_WINDOW=5
CONVERGENCE_THRESHOLD=0.5
MIN_CONCESSION_DELTA=0.5

# Agent models (change if newer free-tier models are available)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.5-flash
